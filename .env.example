# Copy to .env and fill in. .env is git-ignored.

# AI provider: "mock" (default, no API key, deterministic) or "anthropic"
AI_PROVIDER=mock

# Only needed when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-haiku-5-5

# Seconds before a provider call is treated as a timeout
AI_TIMEOUT_SECONDS=20

# Frontend origin allowed by the backend (CORS)
FRONTEND_ORIGIN=http://localhost:5173
