# Copy to .env (repo root or backend/) and adjust. .env is git-ignored.
# Every setting is optional; the defaults below are what the app uses without a .env.

# AI provider. Only "mock" (deterministic keyword rules, no API key) is implemented.
# Any other value stops the backend at startup with a clear error, by design.
AI_PROVIDER=mock

# Frontend origin allowed by the backend (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Backend log level. Logs contain ids, counts and error types only, never message text.
LOG_LEVEL=INFO
